NODE_ENV=production
POSTGRES_USER=lead
POSTGRES_PASSWORD=replace-with-a-long-random-secret
POSTGRES_DB=lead_intelligence
DATABASE_URL=postgres://lead:replace-with-a-long-random-secret@postgres:5432/lead_intelligence
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGIN=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1

WORKER_CONCURRENCY=3
CRAWL_CONCURRENCY=2
ENRICHMENT_CONCURRENCY=2
OUTREACH_CONCURRENCY=2
BROWSER_NO_SANDBOX=true
SWAGGER_ENABLED=false

# Billing
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3
BILLING_RETURN_URL=https://app.example.com/settings/billing
